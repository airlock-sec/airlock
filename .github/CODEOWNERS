# Owner review is required before anything merges in these paths. They carry the trust
# model, the detection logic and the gates, so a small edit there can disable a check
# (project_structure.md 2). Later rules win over earlier ones.

# The roadmap gate itself
/scripts/ @Gabbydunkk

# Detection logic and the rules that feed it
/rules/ @Gabbydunkk
/src/airlock/detectors/ @Gabbydunkk

# Trust model and fail-closed behavior
/src/airlock/policy.py @Gabbydunkk
/src/airlock/collector.py @Gabbydunkk
/src/airlock/runner.py @Gabbydunkk

# Truncation runs before the evidence is hashed, so this constant is what makes a fingerprint
# a prefix comparison; a one-constant edit changes what every existing suppression matches
/src/airlock/fingerprint.py @Gabbydunkk

# The non-suppressible state-rule set and the Severity, Mode and exit-code contract
/src/airlock/model.py @Gabbydunkk

# The role and sensitivity resolution that is the coverage claim every rule depends on
/src/airlock/roles.py @Gabbydunkk

# The escaping boundary for evidence text, which is attacker-controlled
/src/airlock/report/ @Gabbydunkk

# Decides which policy was trusted and runs the pipeline in the one order the design fixes
/src/airlock/cli.py @Gabbydunkk

# A bypass regression is the assertion that a confirmed supply-chain bypass stays closed, the
# same way a rule is; ordinary unit tests and fixtures are not swept in (docs/changes record)
/tests/bypass/ @Gabbydunkk

# Dogfood policy and the Wasm manifest
/airlock.toml @Gabbydunkk
/wasm-manifest.toml @Gabbydunkk

# The supply chain of the tool itself
/action.yml @Gabbydunkk
/.github/workflows/ @Gabbydunkk
/pyproject.toml @Gabbydunkk

# Review enforcement
/.github/CODEOWNERS @Gabbydunkk
