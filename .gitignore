# Git ignores, not scan ignores. The scanner has no default directory skips
# (ARCHITECTURE_ESSENTIALS.md 2); this file does not affect what a scan reads.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
build/
dist/
*.egg-info/
.venv/
venv/
# `uv run --group dev` (AGENTS.md 5) writes this on first use; the project pins dev tool versions
# in pyproject.toml's dev dependency group, not in a lockfile.
uv.lock
